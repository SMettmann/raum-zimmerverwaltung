{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raumwerk",
  "main": "./worker/password-entry.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raumwerk-db",
      "database_id": "30f40d5d-402f-4f7a-90cf-56027e3b2934"
    }
  ],
  "observability": {
    "enabled": true
  }
}